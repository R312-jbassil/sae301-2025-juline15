---

---

<footer class="border-t border-neutral-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-4">
            <!-- Col 1: Brand -->
            <div class="space-y-4">
                <a href="/" class="inline-flex items-center gap-3">
                    <img
                        src="/src/assets/img/logotavue.webp"
                        alt="Logo TaVue"
                        class="h-7 w-auto"
                        loading="lazy"
                        decoding="async"
                    />
                    <span class="sr-only">TaVue</span>
                </a>
                <p class="max-w-xs text-sm leading-6 text-neutral-600">
                    Lunettes sur mesure, fabriquées en France avec des matériaux
                    d'exception.
                </p>
            </div>

            <!-- Col 2: Legal -->
            <div>
                <h3
                    class="text-sm font-semibold tracking-wide text-neutral-900"
                >
                    Légal
                </h3>
                <ul class="mt-4 space-y-3 text-sm">
                    <li>
                        <a
                            href="/mentions-legales"
                            class="text-neutral-700 hover:text-neutral-900 transition-colors"
                            >Mentions légales</a>
                    </li>
                    <li>
                        <a
                            href="/confidentialite"
                            class="text-neutral-700 hover:text-neutral-900 transition-colors"
                            >Politique de confidentialité</a>
                    </li>
                    <li>
                        <a
                            href="/cgv"
                            class="text-neutral-700 hover:text-neutral-900 transition-colors"
                            >CGV</a>
                    </li>
                </ul>
            </div>

            <!-- Col 3: Contact -->
            <div>
                <h3
                    class="text-sm font-semibold tracking-wide text-neutral-900"
                >
                    Contact
                </h3>
                <ul class="mt-4 space-y-3 text-sm text-neutral-700">
                    <li class="flex items-center gap-2">
                        <img
                            class="h-auto w-4"
                            src="/src/assets/img/tel.webp"
                            alt="Icône téléphone"
                        />
                        01 23 45 67 89
                    </li>
                    <li class="flex items-center gap-2">
                        <img
                            class="h-auto w-4"
                            src="/src/assets/img/mail.webp"
                            alt="Icône mail"
                        />
                        <a
                            href="mailto:contact.tavue@gmail.com"
                            class="hover:text-neutral-900 transition-colors"
                            >contact.tavue@gmail.com</a
                        >
                    </li>
                    <li class="flex items-center gap-2">
                        <img
                            class="h-auto w-4"
                            src="/src/assets/img/loc.webp"
                            alt="Icône localisation"
                        />
                        Montbéliard, France
                    </li>
                </ul>
            </div>

            <!-- Col 4: Social -->
            <div>
                <h3
                    class="text-sm font-semibold tracking-wide text-neutral-900"
                >
                    Suivez‑nous
                </h3>
                <div class="mt-4 flex items-center gap-4">
                    <a
                        href="https://facebook.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Facebook"
                        class="text-neutral-600 hover:text-neutral-900 transition-colors"
                    >
                        <img
                            class="h-auto w-6"
                            src="/src/assets/img/facebook.webp"
                            alt="Logo Facebook"
                        />
                    </a>
                    <a
                        href="https://x.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="X"
                        class="text-neutral-600 hover:text-neutral-900 transition-colors"
                    >
                        <img
                            class="h-auto w-6"
                            src="/src/assets/img/x.webp"
                            alt="Logo X (anciennement Twitter)"
                        />
                    </a>
                    <a
                        href="https://instagram.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram"
                        class="text-neutral-600 hover:text-neutral-900 transition-colors"
                    >
                        <img
                            class="h-auto w-6"
                            src="/src/assets/img/instagram.webp"
                            alt="Logo Instagram"
                        />
                    </a>
                </div>
            </div>
        </div>

        <div class="my-8 h-px w-full bg-neutral-200"></div>

        <div class="flex items-center justify-center">
            <p class="text-xs text-neutral-500">
                © 2025 TaVue. Tous droits réservés.
            </p>
        </div>
    </div>
</footer>
