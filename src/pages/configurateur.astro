---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div class="bg-white text-neutral-900">
        <!-- Hero Section -->
        <section
            class="container mx-auto px-4 md:px-8 pt-24 md:pt-32 pb-12 md:pb-16"
        >
            <div
                class="mx-auto flex w-full max-w-4xl flex-col items-center text-center"
            >
                <h1
                    class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight text-neutral-900 mb-6"
                >
                    Créez vos lunettes sur mesure
                </h1>
                <p
                    class="mt-4 max-w-2xl text-base md:text-lg leading-7 text-neutral-600"
                >
                    Personnalisez chaque détail de vos lunettes TaVue,
                    fabriquées en France avec des matériaux d'exception.
                </p>
            </div>
        </section>

        <!-- Main Content -->
        <section class="container mx-auto px-4 md:px-8 pb-16 md:pb-24">
            <div class="mx-auto max-w-6xl">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                    <!-- Left Column: Image and Cards -->
                    <div class="lg:col-span-1 space-y-6">
                        <!-- Image Card -->
                        <div
                            class="bg-neutral-100 rounded-lg p-8 flex items-center justify-center min-h-96"
                        >
                            <div id="glasses-display" class="w-80 h-auto">
                                <!-- SVG sera injecté ici -->
                            </div>
                        </div>

                        <!-- Order Card -->
                        <div
                            class="bg-white rounded-lg p-8 border border-neutral-200 shadow-sm"
                        >
                            <h3
                                class="text-lg font-semibold text-neutral-900 mb-4"
                            >
                                Commandez vos lunettes sur mesure
                            </h3>
                            <p class="text-sm text-neutral-600 mb-6">
                                Votre création unique, fabriquée avec soin par
                                nos artisans français
                            </p>
                            <div class="bg-neutral-50 rounded-md p-6 mb-6">
                                <div
                                    class="flex justify-between items-center mb-2"
                                >
                                    <span class="text-neutral-700 font-medium"
                                        >Total</span
                                    >
                                    <span
                                        class="text-3xl font-bold text-neutral-900"
                                        >299€</span
                                    >
                                </div>
                                <p class="text-xs text-neutral-600">
                                    Livraison gratuite en France
                                </p>
                            </div>
                            <button
                                class="w-full bg-[#1f3c7a] hover:bg-[#1b356c] text-white font-semibold py-3 px-6 rounded-md transition duration-200 flex items-center justify-center gap-2"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2 9m10 0l2 9m-12-9h12"
                                    ></path>
                                </svg>
                                Commander pour 299€
                            </button>
                            <p
                                class="text-xs text-neutral-600 text-center mt-4"
                            >
                                Retours gratuits sous 30 jours
                            </p>
                        </div>
                    </div>

                    <!-- Right Column: Configuration -->
                    <div class="lg:col-span-2 space-y-10">
                        <!-- Monture Section -->
                        <div class="border-b border-neutral-200 pb-8">
                            <h2
                                class="text-xl font-semibold text-neutral-900 mb-6"
                            >
                                Choisissez votre monture
                            </h2>
                            <div class="space-y-6">
                                <div>
                                    <label
                                        class="block text-sm font-semibold text-neutral-900 mb-4"
                                    >
                                        Couleur de la monture
                                    </label>
                                    <div class="flex gap-3 flex-wrap">
                                        <button
                                            id="monture-color-1"
                                            class="group w-12 h-12 rounded-full transition-all duration-300 ring-2 ring-offset-2 ring-offset-white ring-transparent hover:ring-neutral-400"
                                            style="background-color: #301E1D;"
                                            title="Marron foncé"></button>
                                        <button
                                            id="monture-color-2"
                                            class="group w-12 h-12 rounded-full transition-all duration-300 ring-2 ring-offset-2 ring-offset-white ring-transparent hover:ring-neutral-400"
                                            style="background-color: #88807D;"
                                            title="Taupe"></button>
                                        <button
                                            id="monture-color-3"
                                            class="group w-12 h-12 rounded-full transition-all duration-300 ring-2 ring-offset-2 ring-offset-white ring-transparent hover:ring-neutral-400"
                                            style="background-color: #B38458;"
                                            title="Caramel"></button>
                                        <button
                                            id="monture-color-4"
                                            class="group w-12 h-12 rounded-full transition-all duration-300 ring-2 ring-offset-2 ring-offset-white ring-transparent hover:ring-neutral-400"
                                            style="background-color: #D4C5B9;"
                                            title="Crème"></button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Verres Section -->
                        <div class="border-b border-neutral-200 pb-8">
                            <h2
                                class="text-xl font-semibold text-neutral-900 mb-6"
                            >
                                Choisissez vos verres
                            </h2>
                            <div class="space-y-4">
                                <div>
                                    <label
                                        class="block text-sm font-semibold text-neutral-900 mb-4"
                                    >
                                        Couleur des verres
                                    </label>
                                    <div class="flex gap-3 flex-wrap">
                                        <button
                                            id="verres-color-1"
                                            class="group w-12 h-12 rounded-full transition-all duration-300 ring-2 ring-offset-2 ring-offset-white ring-transparent hover:ring-neutral-400"
                                            style="background-color: rgba(100, 150, 255, 0.4);"
                                            title="Bleu clair"></button>
                                        <button
                                            id="verres-color-2"
                                            class="group w-12 h-12 rounded-full transition-all duration-300 ring-2 ring-offset-2 ring-offset-white ring-transparent hover:ring-neutral-400"
                                            style="background-color: rgba(255, 100, 100, 0.4);"
                                            title="Rose clair"></button>
                                        <button
                                            id="verres-color-3"
                                            class="group w-12 h-12 rounded-full transition-all duration-300 ring-2 ring-offset-2 ring-offset-white ring-transparent hover:ring-neutral-400"
                                            style="background-color: rgba(100, 255, 100, 0.4);"
                                            title="Vert clair"></button>
                                        <button
                                            id="verres-color-4"
                                            class="group w-12 h-12 rounded-full transition-all duration-300 ring-2 ring-offset-2 ring-offset-white ring-transparent hover:ring-neutral-400"
                                            style="background-color: rgba(255, 200, 100, 0.4);"
                                            title="Ambre"></button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Branches Section -->
                        <div class="pb-8">
                            <h2
                                class="text-xl font-semibold text-neutral-900 mb-6"
                            >
                                Choisissez vos branches
                            </h2>
                            <div class="space-y-4">
                                <div>
                                    <label
                                        class="block text-sm font-semibold text-neutral-900 mb-4"
                                    >
                                        Couleur des branches
                                    </label>
                                    <div class="flex gap-3 flex-wrap">
                                        <button
                                            id="branches-color-1"
                                            class="group w-12 h-12 rounded-full transition-all duration-300 ring-2 ring-offset-2 ring-offset-white ring-transparent hover:ring-neutral-400"
                                            style="background-color: #61441C;"
                                            title="Marron chocolat"></button>
                                        <button
                                            id="branches-color-2"
                                            class="group w-12 h-12 rounded-full transition-all duration-300 ring-2 ring-offset-2 ring-offset-white ring-transparent hover:ring-neutral-400"
                                            style="background-color: #C8B990;"
                                            title="Beige"></button>
                                        <button
                                            id="branches-color-3"
                                            class="group w-12 h-12 rounded-full transition-all duration-300 ring-2 ring-offset-2 ring-offset-white ring-transparent hover:ring-neutral-400"
                                            style="background-color: #7D65F3;"
                                            title="Violet"></button>
                                        <button
                                            id="branches-color-4"
                                            class="group w-12 h-12 rounded-full transition-all duration-300 ring-2 ring-offset-2 ring-offset-white ring-transparent hover:ring-neutral-400"
                                            style="background-color: #301E1D;"
                                            title="Marron foncé"></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Discovery Section - Full Width -->
        <section
            class="bg-gradient-to-r from-[#1f3c7a] to-[#2a4ba8] py-16 md:py-20"
        >
            <div class="container mx-auto px-4 md:px-8">
                <div class="mx-auto max-w-3xl text-center">
                    <h2
                        class="text-3xl md:text-4xl font-semibold text-white mb-6"
                    >
                        Découvrez notre nouvelle fonctionnalité
                    </h2>
                    <p class="text-lg text-blue-100 mb-8">
                        Donnez vie à votre paire de lunettes sur mesure.
                        Explorez avec l'intelligence artificielle les styles qui
                        vous correspondent.
                    </p>
                    <button
                        class="bg-white hover:bg-neutral-100 text-[#1f3c7a] font-semibold py-4 px-8 rounded-lg transition duration-200 inline-flex items-center gap-3 shadow-lg"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                        Découvrir avec l'IA
                    </button>
                    <p class="text-sm text-blue-50 mt-8">
                        Retrouvez votre création dans votre galerie personnelle,
                        aux côtés de toutes vos autres inspirations.
                    </p>
                </div>
            </div>
        </section>
    </div>

    <script define:vars={{}}>
        // SVG de base avec les nouvelles couleurs
        const baseSVG = `<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" viewBox="0 0 595.28 841.89">
      <defs>
        <style>
          .cls-1 {
            fill: #706f6f;
            mix-blend-mode: multiply;
          }

          .cls-2 {
            isolation: isolate;
          }

          .cls-3, .cls-4 {
            fill: #ffffff;
          }

          .cls-4 {
            stroke: #1d1d1b;
            stroke-miterlimit: 10;
            stroke-width: .5px;
          }

          .cls-5 {
            fill: none;
            opacity: .75;
          }
        </style>
      </defs>
      <g class="cls-2">
        <g id="branches">
          <path d="M108.83,155.14s49.35-5.57,54.93-8.76,11.14-7.96,19.5-9.55,64.48-11.14,64.48-11.14c0,0,7.16-1.99,17.51,5.57s33.04,31.84,39.4,31.05c6.37-.8,9.55-9.55,7.56-13.53s-40.67-32.75-47.36-34.63c-9.53-2.68-21.89-2.39-37.02,0-15.12,2.39-116.22,23.34-116.22,23.34,0,0-13.13,6.12-2.79,17.66Z" fill="#61441C" stroke="#1d1d1b" stroke-miterlimit="10" stroke-width=".5px"/>
          <path d="M308.24,150.76s-.31,6.15-3.98,5.57c-4.97-.78-35.82-33.83-46.17-32.24,0,0,8.53,2.71,18.46,11.64,6.51,5.86,34.42,37.85,31.69,15.03Z" fill="#706f6f" mix-blend-mode="multiply"/>
          <path d="M374.79,179.65l90.54-29.78s22.13-5.63,25.35-4.02,17.71,30.58,17.71,33.8-2.42,14.01-5.63,14.89c-2.33.64-5.33.11-6.84-4.21-1.41-4.02-6.84-31.73-12.47-31.47s-50.7,15.95-50.7,15.95c0,0-13.28,6.44-18.91,11.27s-32.19,11.27-32.19,11.27c0,0-9.66-7.65-6.84-17.71Z" fill="#61441C" stroke="#1d1d1b" stroke-miterlimit="10" stroke-width=".5px"/>
          <path d="M381.34,180.1s102.27-35.19,107.85-31.99c0,0-18.2,2.49-41.76,11.88s-66.09,22.03-66.09,22.03v-1.92Z" fill="#706f6f" mix-blend-mode="multiply"/>
          <path d="M485.36,158.06s3.26,0,4.98,3.45,9.77,24.71,9.77,24.71c0,0,.77,4.98,5.17-2.68,0,0-3.07,9.56-5.36,6.79s-9.77-26.33-9.77-26.33c0,0-2.87-6.74-4.79-5.94Z" fill="#706f6f" mix-blend-mode="multiply"/>
        </g>
        <g id="monture">
          <path d="M385.31,180.81c-.24-3.41-9.57-5.22-12.71-6.4-3.14-1.18-15.7,1.96-15.7,1.96-12.17-3.14-54.55-9.03-78.88-9.03s-32.57,11.38-35.32,10.99c-2.75-.39-17.27-.78-23.55-1.96-6.28-1.18-5.1-14.13-39.25-26.48-34.14-12.35-68.29-12.42-68.29-12.42-13.35,4.66-6.76,18.49-6.76,18.49l2.05,6.35c4.32,2.03,3.14,10.52,4.71,23.08s7.46,28.65,14.13,38.46c6.67,9.81,31.79,20.8,44.35,21.19s23.55-1.96,31.79-15.31c8.24-13.34,16.88-36.89,16.88-36.89l10.2,1.57s2.91.31,5.35,3.09,4.43,8.03,7.6,17.31c7.56,22.1,25.12,39.25,25.12,39.25,0,0,5.6,7.43,33.44,12.66,23.08,4.34,42.7-2.46,42.7-2.46,17.72-7.17,21.63-44.96,21.63-44.96,0,0,1.83-13.3,7.81-16.65,7.37-4.14,8.27-4.44,12.71-5.32,3.61-.71.24-13.13,0-16.54ZM190.5,231.32c-9.42,5.1-32.18,7.06-46.31-3.92-14.13-10.99-20.8-30.22-22.76-52.98s7.1-25.23,7.1-25.23c0,0,14.88-.67,34.11,4.03,19.23,4.71,40.42,18.05,40.82,26.69.39,8.63-3.53,46.31-12.95,51.41ZM344.73,255.65c-9.03,4.32-21.47,4.71-31.93,3.92-10.46-.78-37.54-1.57-47.35-31.4,0,0-2.75-14.13-5.1-17.27-2.35-3.14-9.42-14.48-9.42-18.43,0-8.23,7.15-12.97,7.15-12.97,0,0,8.16-5.1,18.75-5.1,10.6,0,64.75,2.75,72.21,12.95,7.46,10.2,7.06,21.98,8.24,31.4,1.18,9.42-3.53,32.57-12.56,36.89Z" fill="#301E1D" stroke="#1d1d1b" stroke-miterlimit="10" stroke-width=".5px"/>
        </g>
        <g id="verres">
          <path d="M116.32,162.87c-.88,6.05.4,37.41,11.44,55.31s37.04,21.35,41.37,21.31,18.51,1.02,24.47-9.27c4.97-8.59,13.17-43.48,9.12-53.05-6.26-14.82-40.4-24.02-40.4-24.02,0,0-26.85-5.46-33.82-4.46,0,0-9.97-.96-12.17,14.17Z" fill="rgba(100, 150, 255, 0.4)" stroke="none"/>
          <path d="M247.32,192.54s-1.09-9.55,19.57-16.69c11.76-4.06,60.46,3.23,60.46,3.23,0,0,19.09,4.06,21.71,8.28,2.62,4.22,9.46,17.24,8.29,37.97-1.14,20.21-7.31,26.8-12.61,30.31,0,0-7.1,4.93-21.34,5.93-26.65,1.88-37.01-1.14-46.19-7.73-29.88-21.46-29.88-61.3-29.88-61.3Z" fill="rgba(100, 150, 255, 0.4)" stroke="none"/>
        </g>
      </g>
    </svg>`;

        let currentMontureColor = "#301E1D";
        let currentBranchesColor = "#61441C";
        let currentVerresColor = "rgba(100, 150, 255, 0.4)";

        function updateSVG() {
            const glassesDisplay = document.getElementById("glasses-display");
            let updatedSVG = baseSVG;

            updatedSVG = updatedSVG.replace(
                /<g id="monture">([\s\S]*?)<\/g>/,
                function (match, content) {
                    return (
                        '<g id="monture">' +
                        content.replace(
                            /fill="#301E1D"/g,
                            `fill="${currentMontureColor}"`,
                        ) +
                        "</g>"
                    );
                },
            );

            updatedSVG = updatedSVG.replace(
                /<g id="branches">([\s\S]*?)<\/g>/,
                function (match, content) {
                    return (
                        '<g id="branches">' +
                        content.replace(
                            /fill="#61441C"/g,
                            `fill="${currentBranchesColor}"`,
                        ) +
                        "</g>"
                    );
                },
            );

            updatedSVG = updatedSVG.replace(
                /<g id="verres">([\s\S]*?)<\/g>/,
                function (match, content) {
                    return (
                        '<g id="verres">' +
                        content.replace(
                            /fill="rgba\(100, 150, 255, 0\.4\)"/g,
                            `fill="${currentVerresColor}"`,
                        ) +
                        "</g>"
                    );
                },
            );

            glassesDisplay.innerHTML = updatedSVG;
        }

        // Boutons de couleur monture
        document
            .getElementById("monture-color-1")
            .addEventListener("click", function () {
                currentMontureColor = "#301E1D";
                updateSVG();
                updateButtonSelection("monture", 1);
            });
        document
            .getElementById("monture-color-2")
            .addEventListener("click", function () {
                currentMontureColor = "#88807D";
                updateSVG();
                updateButtonSelection("monture", 2);
            });
        document
            .getElementById("monture-color-3")
            .addEventListener("click", function () {
                currentMontureColor = "#B38458";
                updateSVG();
                updateButtonSelection("monture", 3);
            });
        document
            .getElementById("monture-color-4")
            .addEventListener("click", function () {
                currentMontureColor = "#D4C5B9";
                updateSVG();
                updateButtonSelection("monture", 4);
            });

        // Boutons de couleur verres
        document
            .getElementById("verres-color-1")
            .addEventListener("click", function () {
                currentVerresColor = "rgba(100, 150, 255, 0.4)";
                updateSVG();
                updateButtonSelection("verres", 1);
            });
        document
            .getElementById("verres-color-2")
            .addEventListener("click", function () {
                currentVerresColor = "rgba(255, 100, 100, 0.4)";
                updateSVG();
                updateButtonSelection("verres", 2);
            });
        document
            .getElementById("verres-color-3")
            .addEventListener("click", function () {
                currentVerresColor = "rgba(100, 255, 100, 0.4)";
                updateSVG();
                updateButtonSelection("verres", 3);
            });
        document
            .getElementById("verres-color-4")
            .addEventListener("click", function () {
                currentVerresColor = "rgba(255, 200, 100, 0.4)";
                updateSVG();
                updateButtonSelection("verres", 4);
            });

        // Boutons de couleur branches
        document
            .getElementById("branches-color-1")
            .addEventListener("click", function () {
                currentBranchesColor = "#61441C";
                updateSVG();
                updateButtonSelection("branches", 1);
            });
        document
            .getElementById("branches-color-2")
            .addEventListener("click", function () {
                currentBranchesColor = "#C8B990";
                updateSVG();
                updateButtonSelection("branches", 2);
            });
        document
            .getElementById("branches-color-3")
            .addEventListener("click", function () {
                currentBranchesColor = "#7D65F3";
                updateSVG();
                updateButtonSelection("branches", 3);
            });
        document
            .getElementById("branches-color-4")
            .addEventListener("click", function () {
                currentBranchesColor = "#301E1D";
                updateSVG();
                updateButtonSelection("branches", 4);
            });

        // Fonction pour mettre à jour l'apparence du bouton sélectionné
        function updateButtonSelection(type, colorIndex) {
            const buttons = document.querySelectorAll(
                `#${type}-color-1, #${type}-color-2, #${type}-color-3, #${type}-color-4`,
            );
            buttons.forEach((btn, index) => {
                if (index + 1 === colorIndex) {
                    btn.classList.remove("ring-transparent");
                    btn.classList.add("ring-[#1f3c7a]");
                } else {
                    btn.classList.remove("ring-[#1f3c7a]");
                    btn.classList.add("ring-transparent");
                }
            });
        }

        // Initialiser
        updateSVG();
        updateButtonSelection("monture", 1);
        updateButtonSelection("verres", 1);
        updateButtonSelection("branches", 1);
    </script>
</Layout>
