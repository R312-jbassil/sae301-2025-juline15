---
import Layout from "../layouts/Layout.astro";

if (Astro.locals.user) {
    return Astro.redirect("/");
}
---

<Layout>
    <div class="min-h-screen flex flex-col items-center justify-center px-4">
        <div class="w-full max-w-md">
            <!-- Header -->
            <div class="w-full max-w-md">
                <!-- Header -->
                <div class="text-center mb-12">
                    <h1
                        class="text-3xl md:text-4xl font-semibold tracking-tight text-[#1f3c7a] mb-4"
                    >
                        Se connecter
                    </h1>
                    <p class="text-neutral-600">Accédez à votre compte</p>
                </div>

                <!-- Form Card -->
                <div
                    class="bg-white rounded-lg p-8 border border-neutral-200 shadow-sm"
                >
                    <form id="login-form" class="flex flex-col gap-4">
                        <div>
                            <label
                                class="block text-sm font-semibold text-neutral-900 mb-2"
                            >
                                Email
                            </label>
                            <input
                                type="email"
                                name="email"
                                placeholder="votre@email.com"
                                required
                                class="w-full px-4 py-3 border border-neutral-300 rounded-md bg-white text-neutral-900 focus:outline-none focus:ring-2 focus:ring-[#1f3c7a] focus:border-transparent"
                            />
                        </div>
                        <div>
                            <label
                                class="block text-sm font-semibold text-neutral-900 mb-2"
                            >
                                Mot de passe
                            </label>
                            <input
                                type="password"
                                name="password"
                                placeholder="••••••••"
                                required
                                class="w-full px-4 py-3 border border-neutral-300 rounded-md bg-white text-neutral-900 focus:outline-none focus:ring-2 focus:ring-[#1f3c7a] focus:border-transparent"
                            />
                        </div>
                        <button
                            type="submit"
                            class="w-full bg-gradient-to-r from-[#1f3c7a] to-[#2a4ba8] hover:from-[#1b356c] hover:to-[#244a95] text-white font-semibold py-3 px-6 rounded-md transition duration-200 mt-4"
                        >
                            Se connecter
                        </button>
                    </form>

                    <!-- Status Message -->
                    <p id="status" class="mt-6 text-center text-sm font-medium">
                    </p>
                </div>

                <!-- Additional Links -->
                <div class="text-center mt-6">
                    <p class="text-neutral-600 text-sm">
                        Pas encore de compte ?
                        <a
                            href="/signup"
                            class="text-[#1f3c7a] hover:text-[#1b356c] font-semibold"
                        >
                            S'inscrire
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    //@ts-nocheck
    localStorage.removeItem("user");
    const form = document.getElementById("login-form");
    const status = document.getElementById("status");

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const formData = new FormData(form);

        const res = await fetch("/api/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                email: formData.get("email"),
                password: formData.get("password"),
            }),
            credentials: "include",
        });

        if (res.ok) {
            const resData = await res.json();
            localStorage.setItem("user", JSON.stringify(resData.user));
            status.textContent = "✅ Connexion réussie !";
            status.classList.add("text-green-600");
            setTimeout(() => {
                window.location.href = "/configurateur";
            }, 1000);
        } else {
            status.textContent = "❌ Email ou mot de passe invalide";
            status.classList.add("text-red-600");
        }
    });
</script>
